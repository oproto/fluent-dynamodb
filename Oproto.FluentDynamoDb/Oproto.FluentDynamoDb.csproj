<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IsPackable>true</IsPackable>
        <StripSymbols>false</StripSymbols>
        <LangVersion>12.0</LangVersion>
    </PropertyGroup>

    <!-- Make internal types visible to test projects and extension packages -->
    <ItemGroup>
        <InternalsVisibleTo Include="Oproto.FluentDynamoDb.UnitTests" />
        <InternalsVisibleTo Include="Oproto.FluentDynamoDb.IntegrationTests" />
        <InternalsVisibleTo Include="Oproto.FluentDynamoDb.Geospatial" />
    </ItemGroup>

    <PropertyGroup>
        
        <!-- Package metadata -->
        <PackageId>Oproto.FluentDynamoDb</PackageId>
        <Title>Oproto.FluentDynamoDb</Title>
        <Description>A fluent-style API wrapper for Amazon DynamoDB with source generator support for automatic entity mapping, field constants, and key builders. Provides type-safe, AOT-compatible DynamoDB operations with minimal boilerplate code.</Description>
        <Authors>Oproto</Authors>
        <PackageTags>dynamodb;aws;fluent;aot;source-generator;entity-mapping</PackageTags>
        <PackageProjectUrl>https://fluentdynamodb.dev/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/oproto/fluent-dynamodb</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.DynamoDBv2" Version="[4.0.0,5.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="RealworldExample/**" />
    </ItemGroup>

    <!-- Include README in package -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- 
        Source Generator bundling using ProjectReference approach.
        This ensures:
        1. Source generator builds BEFORE main library (dependency order)
        2. Source generator is available as analyzer during compilation
        3. Source generator DLL is included in NuGet package at analyzers/dotnet/cs/
        4. No runtime dependency is created (ReferenceOutputAssembly=false)
    -->
    <ItemGroup>
        <ProjectReference Include="..\Oproto.FluentDynamoDb.SourceGenerator\Oproto.FluentDynamoDb.SourceGenerator.csproj"
                          PrivateAssets="all"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Analyzer" />
    </ItemGroup>

    <!-- Pack the source generator into the NuGet package -->
    <Target Name="IncludeSourceGeneratorInPackage" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <_PackageFiles Include="..\Oproto.FluentDynamoDb.SourceGenerator\bin\$(Configuration)\netstandard2.0\Oproto.FluentDynamoDb.SourceGenerator.dll"
                           PackagePath="analyzers/dotnet/cs"
                           BuildAction="None" />
        </ItemGroup>
    </Target>

</Project>
